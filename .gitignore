############################
# Your existing custom rules
############################

*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files (specific ones – optional, but harmless)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage

# Crashlytics generated file
crashlytics-build.properties


############################
# Unity-specific ignores
############################

# Folders generated by Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]ser[Ss]ettings/   # ignore your local Unity editor settings

# Asset store tools
[Aa]sset[Ss]tore/

# Cache
/[Uu]nity[Pp]ackage[Mm]anager/
[Uu]nity[Cc]ache/
[Pp]ackage[Cc]ache/

# Lightmap and GI cache (optional; often fine to ignore)
[Ll]ightmapSnapshot/
[Aa]ddressable[Aa]ssets[Dd]ata/*/addressables_content_state.bin

# Autogenerated files
*.pidb
*.booproj
*.suo
*.user
*.userosscache
*.sln.docstates
*.tmp
*.userprefs

# Rider / IntelliJ / VS / VS Code
.idea/
.vs/
*.csproj
*.unityproj
*.sln
*.vcxproj
*.vcxproj.filters
*.pidb
*.svd
*.pdb
*.mdb

# VS Code
.vscode/

# Crash / report files
sysinfo.txt
*.stacktrace
*.log

# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Android / Gradle
.gradle/
**/gradle-wrapper.jar
*.apk
*.aab
*.unitypackage

# Misc
[Tt]est[Rr]esult*/
[Bb]uild[Rr]esult*/
